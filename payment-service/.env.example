# --- ProCredit / Quipu payment gateway ---
# TEST uses port 8000, PRODUCTION uses port 8443 (confirmed by bank 14 Aug 2026).
# Outbound traffic to those ports must be allowed from this host.
# No IP whitelisting is applied on the bank side.
PG_API_URL=https://3dss2test.quipu.de:8000/order
MERCHANT_ID=ECOM_TEST351
# Confirmed by bank: 1 = one-time payment (the only type we use).
# Recurring / tokenization is NOT offered by this gateway at all.
PG_TYPE_RID=1

# mTLS material. Paths INSIDE the container/host. NEVER commit these files.
PG_CERT_PATH=/certs/cert.pem
PG_KEY_PATH=/certs/key.pem
PG_CA_PATH=/certs/ca.pem

# --- Site ---
SITE_URL=https://coworkingprilep.mk
ALLOWED_ORIGIN=https://coworkingprilep.mk
PORT=8080

# --- Supabase (service role: server-side only) ---
SUPABASE_URL=https://iikrjwnwejliupiwrnpy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (receipt email is MANDATORY per acquirer rules) ---
RESEND_API_KEY=
FROM_ADDRESS=
FROM_NAME=Coworking Prilep
